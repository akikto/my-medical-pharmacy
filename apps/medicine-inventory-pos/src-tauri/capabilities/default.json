{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Local database and native file dialog access for MY MEDICAL windows.",
  "windows": ["main", "receipt-print"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "opener:allow-default-urls",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "sms:*" },
        { "url": "upi:*" }
      ]
    }
  ]
}