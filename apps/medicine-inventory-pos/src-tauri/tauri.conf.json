{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PharmaDesk",
  "version": "0.1.0",
  "identifier": "com.pharmadesk.offline",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PharmaDesk | Pharmacy POS",
        "width": 1440,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:5173; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "Offline pharmacy point of sale"
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:pharmacy.db"]
    }
  }
}